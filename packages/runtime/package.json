{
  "name": "inception-workflows",
  "version": "0.1.0",
  "description": "Workflow runtime for inception: agent()/parallel()/pipeline()/budget over @flue/sdk, with journaling, resume, and a watch CLI",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" }
  },
  "bin": { "inception-watch": "bin/inception-watch.mjs" },
  "files": ["dist", "bin", "README.md"],
  "scripts": {
    "build": "tsc",
    "test": "vitest run"
  },
  "engines": { "node": ">=22.18.0" },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "repository": { "type": "git", "url": "https://github.com/Milind220/inception" },
  "keywords": ["agents", "workflow", "orchestration", "subagents", "flue", "llm"]
